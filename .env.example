# ─────────────────────────────────────────────────────────────────────────────
# A股 AI 量化交易系统 · 环境变量
# 复制本文件为 .env 后填入实际值
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── oMLX 模型服务 ─────────────────────────────────────────────────────────
# Studio Mac 上部署的 oMLX 服务地址（内网）
OLLAMA_BASE_URL=http://127.0.0.1:8000
OLLAMA_API_KEY=sk-placeholder

# ── 默认模型 ───────────────────────────────────────────────────────────────
# API 端使用（前端切换）
OLLAMA_MODEL=Qwen3.5-9B-MLX-4bit

# ── 模拟仓初始资金 ─────────────────────────────────────────────────────────
INITIAL_CASH=1000000.00

# ── 交易通道 ───────────────────────────────────────────────────────────────
# simulation（默认） | qmt | webhook | joinquant
BROKER_MODE=simulation

# ── 飞书盘后汇报（可选）───────────────────────────────────────────────────
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
